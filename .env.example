# Copy this file to .env and fill in real values. Never commit .env.
#
# Get a token from @BotFather on Telegram.
BOT_TOKEN=123456789:replace-with-your-own-token

# Comma-separated numeric Telegram user IDs allowed to run admin commands.
# Message @userinfobot to find your own numeric ID.
ADMIN_TELEGRAM_IDS=123456789,987654321

# Path to the SQLite file. Created automatically on first run.
DB_PATH=wave_academy.db

# Currency label shown next to payment amounts.
DEFAULT_CURRENCY=ETB
